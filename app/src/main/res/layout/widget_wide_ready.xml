<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_widget_ground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
    <LinearLayout android:id="@+id/register" android:layout_width="112dp" android:layout_height="112dp"
        android:background="@drawable/bg_disc_hot" android:gravity="center" android:orientation="vertical">
        <ImageView android:layout_width="36dp" android:layout_height="26dp" android:importantForAccessibility="no" android:src="@drawable/ic_waves_widget" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="@string/register" android:textColor="@color/on_hot" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/today" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/ink" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/last" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textColor="@color/muted" android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
