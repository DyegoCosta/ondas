<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_widget_cool" android:gravity="center_vertical" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:importantForAccessibility="no" android:src="@drawable/ic_check_widget" />
        <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <TextView android:id="@+id/annotate" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="4dp" android:layout_weight="1"
            android:background="@drawable/bg_pill_cool" android:gravity="center" android:text="@string/annotate"
            android:textColor="@color/on_cool" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/undo" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:layout_weight="1"
            android:background="@drawable/bg_pill_outline" android:gravity="center" android:text="@string/undo"
            android:textColor="@color/cool" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
